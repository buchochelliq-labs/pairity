# Shared CLI and Python SDK scope policy; credentials come from environment secrets.
[pairity-ci]
scopes = apps,bundle-deployments,databricks-connect,files,jobs,sql,unity-catalog,workspace

# App deployment also provisions its Lakebase project.
[pairity-app-ci]
scopes = apps,bundle-deployments,files,jobs,postgres,sql,workspace

# Minimal App deployment only: no data, Jobs or database scopes.
[pairity-simple-app-ci]
scopes = apps,bundle-deployments,files,workspace

# Endpoint-format experiment: credential generation only.
[pairity-lakebase-probe]
scopes = postgres
http_timeout_seconds = 15
retry_timeout_seconds = 30
