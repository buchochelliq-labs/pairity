{
  "$defs": {
    "ColumnMapping": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Candidate",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "ColumnMapping",
      "type": "object"
    },
    "ColumnRule": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "default": 0,
          "minimum": 0,
          "title": "Absolute Tolerance",
          "type": "number"
        },
        "relative_tolerance": {
          "default": 0,
          "minimum": 0,
          "title": "Relative Tolerance",
          "type": "number"
        }
      },
      "title": "ColumnRule",
      "type": "object"
    },
    "ComparisonOverrides": {
      "additionalProperties": false,
      "properties": {
        "schema_policy": {
          "title": "Schema Policy",
          "const": "strict",
          "type": "string"
        },
        "exclude_columns": {
          "title": "Exclude Columns",
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "type": "array"
        },
        "column_rules": {
          "title": "Column Rules",
          "patternProperties": {
            "^[^\\x00-\\x1f]+$": {
              "$ref": "#/$defs/ColumnRule"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "max_changed_rows": {
          "title": "Max Changed Rows",
          "minimum": 0,
          "type": "integer"
        },
        "max_missing_rows": {
          "title": "Max Missing Rows",
          "minimum": 0,
          "type": "integer"
        },
        "max_extra_rows": {
          "title": "Max Extra Rows",
          "minimum": 0,
          "type": "integer"
        },
        "allow_key_only": {
          "title": "Allow Key Only",
          "type": "boolean"
        }
      },
      "title": "ComparisonOverrides",
      "type": "object"
    },
    "ComparisonSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_policy": {
          "const": "strict",
          "default": "strict",
          "title": "Schema Policy",
          "type": "string"
        },
        "exclude_columns": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Exclude Columns",
          "type": "array"
        },
        "column_rules": {
          "patternProperties": {
            "^[^\\x00-\\x1f]+$": {
              "$ref": "#/$defs/ColumnRule"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Column Rules",
          "type": "object"
        },
        "max_changed_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Changed Rows",
          "type": "integer"
        },
        "max_missing_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Missing Rows",
          "type": "integer"
        },
        "max_extra_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Extra Rows",
          "type": "integer"
        },
        "allow_key_only": {
          "default": false,
          "title": "Allow Key Only",
          "type": "boolean"
        }
      },
      "title": "ComparisonSettings",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "max_parallel_pairs": {
          "default": 4,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Parallel Pairs",
          "type": "integer"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "PairConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Id",
          "type": "string"
        },
        "baseline": {
          "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
          "title": "Candidate",
          "type": "string"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ColumnMapping"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnMapping"
          },
          "title": "Columns",
          "type": "array"
        },
        "compare": {
          "$ref": "#/$defs/ComparisonOverrides"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "baseline_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version"
        },
        "candidate_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Version"
        }
      },
      "required": [
        "id",
        "baseline",
        "candidate"
      ],
      "title": "PairConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "suite": {
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "title": "Suite",
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/ComparisonSettings"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PairConfig"
      },
      "minItems": 1,
      "title": "Pairs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "suite",
    "pairs"
  ],
  "title": "Pairity regression suite configuration v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchochelliq-labs/pairity/raw/main/schema/pairity.schema.json",
  "description": "Validates decoded JSON or YAML. Run pairity validate for cross-field uniqueness and semantic checks; table and PK availability are checked at execution time."
}
