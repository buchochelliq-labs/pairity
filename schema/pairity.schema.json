{
  "$defs": {
    "ColumnMapping": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Baseline",
          "type": "string"
        },
        "candidate": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Candidate",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "title": "ColumnMapping",
      "type": "object"
    },
    "ColumnRule": {
      "additionalProperties": false,
      "properties": {
        "compare_as": {
          "anyOf": [
            {
              "pattern": "^(string|boolean|byte|short|int|long|float|double|date|timestamp|timestamp_ntz|decimal\\([0-9]+,[0-9]+\\))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare As"
        },
        "implicit_casts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implicit Casts"
        },
        "null_safe": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Safe"
        },
        "comparator": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator"
        },
        "array_order": {
          "anyOf": [
            {
              "enum": [
                "ordered",
                "unordered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Array Order"
        },
        "absolute_tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Tolerance"
        },
        "relative_tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Tolerance"
        }
      },
      "title": "ColumnRule",
      "type": "object"
    },
    "ComparisonOverrides": {
      "additionalProperties": false,
      "properties": {
        "column_policy": {
          "title": "Column Policy",
          "enum": [
            "strict",
            "common"
          ],
          "type": "string"
        },
        "implicit_casts": {
          "title": "Implicit Casts",
          "type": "boolean"
        },
        "null_safe": {
          "title": "Null Safe",
          "type": "boolean"
        },
        "schema_policy": {
          "title": "Schema Policy",
          "const": "strict",
          "type": "string"
        },
        "exclude_columns": {
          "title": "Exclude Columns",
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "type": "array"
        },
        "column_rules": {
          "title": "Column Rules",
          "patternProperties": {
            "^[^\\x00-\\x1f]+$": {
              "$ref": "#/$defs/ColumnRule"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "max_changed_rows": {
          "title": "Max Changed Rows",
          "minimum": 0,
          "type": "integer"
        },
        "max_missing_rows": {
          "title": "Max Missing Rows",
          "minimum": 0,
          "type": "integer"
        },
        "max_extra_rows": {
          "title": "Max Extra Rows",
          "minimum": 0,
          "type": "integer"
        },
        "allow_key_only": {
          "title": "Allow Key Only",
          "type": "boolean"
        }
      },
      "title": "ComparisonOverrides",
      "type": "object"
    },
    "ComparisonSettings": {
      "additionalProperties": false,
      "properties": {
        "column_policy": {
          "default": "strict",
          "enum": [
            "strict",
            "common"
          ],
          "title": "Column Policy",
          "type": "string"
        },
        "implicit_casts": {
          "default": true,
          "title": "Implicit Casts",
          "type": "boolean"
        },
        "null_safe": {
          "default": true,
          "title": "Null Safe",
          "type": "boolean"
        },
        "schema_policy": {
          "const": "strict",
          "default": "strict",
          "title": "Schema Policy",
          "type": "string"
        },
        "exclude_columns": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Exclude Columns",
          "type": "array"
        },
        "column_rules": {
          "patternProperties": {
            "^[^\\x00-\\x1f]+$": {
              "$ref": "#/$defs/ColumnRule"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Column Rules",
          "type": "object"
        },
        "max_changed_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Changed Rows",
          "type": "integer"
        },
        "max_missing_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Missing Rows",
          "type": "integer"
        },
        "max_extra_rows": {
          "default": 0,
          "minimum": 0,
          "title": "Max Extra Rows",
          "type": "integer"
        },
        "allow_key_only": {
          "default": false,
          "title": "Allow Key Only",
          "type": "boolean"
        }
      },
      "title": "ComparisonSettings",
      "type": "object"
    },
    "DeduplicateSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "deduplicate",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
              "type": "string"
            },
            {
              "discriminator": {
                "mapping": {
                  "deduplicate": "#/$defs/DeduplicateSource",
                  "parameter": "#/$defs/ParameterSource",
                  "sql": "#/$defs/SqlSource",
                  "table": "#/$defs/TableSource",
                  "template": "#/$defs/TemplateSource",
                  "union": "#/$defs/UnionSource"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TableSource"
                },
                {
                  "$ref": "#/$defs/UnionSource"
                },
                {
                  "$ref": "#/$defs/DeduplicateSource"
                },
                {
                  "$ref": "#/$defs/TemplateSource"
                },
                {
                  "$ref": "#/$defs/ParameterSource"
                },
                {
                  "$ref": "#/$defs/SqlSource"
                }
              ]
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "DeduplicateSource",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "max_parallel_pairs": {
          "default": 4,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Parallel Pairs",
          "type": "integer"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "PairConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Id",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
              "type": "string"
            },
            {
              "discriminator": {
                "mapping": {
                  "deduplicate": "#/$defs/DeduplicateSource",
                  "parameter": "#/$defs/ParameterSource",
                  "sql": "#/$defs/SqlSource",
                  "table": "#/$defs/TableSource",
                  "template": "#/$defs/TemplateSource",
                  "union": "#/$defs/UnionSource"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TableSource"
                },
                {
                  "$ref": "#/$defs/UnionSource"
                },
                {
                  "$ref": "#/$defs/DeduplicateSource"
                },
                {
                  "$ref": "#/$defs/TemplateSource"
                },
                {
                  "$ref": "#/$defs/ParameterSource"
                },
                {
                  "$ref": "#/$defs/SqlSource"
                }
              ]
            }
          ],
          "title": "Baseline"
        },
        "candidate": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
              "type": "string"
            },
            {
              "discriminator": {
                "mapping": {
                  "deduplicate": "#/$defs/DeduplicateSource",
                  "parameter": "#/$defs/ParameterSource",
                  "sql": "#/$defs/SqlSource",
                  "table": "#/$defs/TableSource",
                  "template": "#/$defs/TemplateSource",
                  "union": "#/$defs/UnionSource"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TableSource"
                },
                {
                  "$ref": "#/$defs/UnionSource"
                },
                {
                  "$ref": "#/$defs/DeduplicateSource"
                },
                {
                  "$ref": "#/$defs/TemplateSource"
                },
                {
                  "$ref": "#/$defs/ParameterSource"
                },
                {
                  "$ref": "#/$defs/SqlSource"
                }
              ]
            }
          ],
          "title": "Candidate"
        },
        "keys": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ColumnMapping"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keys"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnMapping"
          },
          "title": "Columns",
          "type": "array"
        },
        "compare": {
          "$ref": "#/$defs/ComparisonOverrides"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "baseline_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Version"
        },
        "candidate_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Version"
        }
      },
      "required": [
        "id",
        "baseline",
        "candidate"
      ],
      "title": "PairConfig",
      "type": "object"
    },
    "ParameterSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "parameter",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ParameterSource",
      "type": "object"
    },
    "SourceTemplate": {
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "title": "Parameters",
          "type": "array"
        },
        "values": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
              "type": "string"
            },
            {
              "discriminator": {
                "mapping": {
                  "deduplicate": "#/$defs/DeduplicateSource",
                  "parameter": "#/$defs/ParameterSource",
                  "sql": "#/$defs/SqlSource",
                  "table": "#/$defs/TableSource",
                  "template": "#/$defs/TemplateSource",
                  "union": "#/$defs/UnionSource"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TableSource"
                },
                {
                  "$ref": "#/$defs/UnionSource"
                },
                {
                  "$ref": "#/$defs/DeduplicateSource"
                },
                {
                  "$ref": "#/$defs/TemplateSource"
                },
                {
                  "$ref": "#/$defs/ParameterSource"
                },
                {
                  "$ref": "#/$defs/SqlSource"
                }
              ]
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "source"
      ],
      "title": "SourceTemplate",
      "type": "object"
    },
    "SqlSource": {
      "additionalProperties": false,
      "description": "A read-only query over declared inputs; see pairity.sql_guard for the subset.",
      "properties": {
        "kind": {
          "const": "sql",
          "title": "Kind",
          "type": "string"
        },
        "query": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "inputs": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
                  "type": "string"
                },
                {
                  "discriminator": {
                    "mapping": {
                      "deduplicate": "#/$defs/DeduplicateSource",
                      "parameter": "#/$defs/ParameterSource",
                      "sql": "#/$defs/SqlSource",
                      "table": "#/$defs/TableSource",
                      "template": "#/$defs/TemplateSource",
                      "union": "#/$defs/UnionSource"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/TableSource"
                    },
                    {
                      "$ref": "#/$defs/UnionSource"
                    },
                    {
                      "$ref": "#/$defs/DeduplicateSource"
                    },
                    {
                      "$ref": "#/$defs/TemplateSource"
                    },
                    {
                      "$ref": "#/$defs/ParameterSource"
                    },
                    {
                      "$ref": "#/$defs/SqlSource"
                    }
                  ]
                }
              ]
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "parameters": {
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/ValueRef"
                }
              ]
            }
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "query",
        "inputs"
      ],
      "title": "SqlSource",
      "type": "object"
    },
    "TableSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "table",
          "default": "table",
          "title": "Kind",
          "type": "string"
        },
        "table": {
          "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
          "title": "Table",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "table"
      ],
      "title": "TableSource",
      "type": "object"
    },
    "TemplateSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "template",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "patternProperties": {
            "^[^\\x00-\\x1f]+$": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
                  "type": "string"
                },
                {
                  "discriminator": {
                    "mapping": {
                      "deduplicate": "#/$defs/DeduplicateSource",
                      "parameter": "#/$defs/ParameterSource",
                      "sql": "#/$defs/SqlSource",
                      "table": "#/$defs/TableSource",
                      "template": "#/$defs/TemplateSource",
                      "union": "#/$defs/UnionSource"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/TableSource"
                    },
                    {
                      "$ref": "#/$defs/UnionSource"
                    },
                    {
                      "$ref": "#/$defs/DeduplicateSource"
                    },
                    {
                      "$ref": "#/$defs/TemplateSource"
                    },
                    {
                      "$ref": "#/$defs/ParameterSource"
                    },
                    {
                      "$ref": "#/$defs/SqlSource"
                    }
                  ]
                }
              ]
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "$ref": "#/$defs/ValueRef"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "TemplateSource",
      "type": "object"
    },
    "UnionSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "union",
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*\\.[A-Za-z_][\\w-]*$",
                "type": "string"
              },
              {
                "discriminator": {
                  "mapping": {
                    "deduplicate": "#/$defs/DeduplicateSource",
                    "parameter": "#/$defs/ParameterSource",
                    "sql": "#/$defs/SqlSource",
                    "table": "#/$defs/TableSource",
                    "template": "#/$defs/TemplateSource",
                    "union": "#/$defs/UnionSource"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/TableSource"
                  },
                  {
                    "$ref": "#/$defs/UnionSource"
                  },
                  {
                    "$ref": "#/$defs/DeduplicateSource"
                  },
                  {
                    "$ref": "#/$defs/TemplateSource"
                  },
                  {
                    "$ref": "#/$defs/ParameterSource"
                  },
                  {
                    "$ref": "#/$defs/SqlSource"
                  }
                ]
              }
            ]
          },
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "sources"
      ],
      "title": "UnionSource",
      "type": "object"
    },
    "ValueRef": {
      "additionalProperties": false,
      "description": "A template value parameter; bound by the referencing template source.",
      "properties": {
        "kind": {
          "const": "value",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ValueRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "suite": {
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "title": "Suite",
      "type": "string"
    },
    "templates": {
      "patternProperties": {
        "^[^\\x00-\\x1f]+$": {
          "$ref": "#/$defs/SourceTemplate"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Templates",
      "type": "object"
    },
    "defaults": {
      "$ref": "#/$defs/ComparisonSettings"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PairConfig"
      },
      "minItems": 1,
      "title": "Pairs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "suite",
    "pairs"
  ],
  "title": "Pairity regression suite configuration v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchochelliq-labs/pairity/raw/main/schema/pairity.schema.json",
  "description": "Validates decoded JSON or YAML. Run pairity validate for cross-field uniqueness and semantic checks; table and PK availability are checked at execution time."
}
